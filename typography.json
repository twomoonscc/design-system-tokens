{
  "Typography": {
    "font-size": {
      "3xl": {
        "$value": "{text.3xl}",
        "$type": "fontSizes",
        "$description": "3X Large font size."
      },
      "2xl": {
        "$value": "{text.2xl}",
        "$type": "fontSizes",
        "$description": "2X Large font size."
      },
      "xs": {
        "$value": "{text.xs}",
        "$type": "fontSizes",
        "$description": "Extra small font size."
      },
      "xl": {
        "$value": "{text.xl}",
        "$type": "fontSizes",
        "$description": "Extra large font size."
      },
      "sm": {
        "$value": "{text.sm}",
        "$type": "fontSizes",
        "$description": "Small font size."
      },
      "4xl": {
        "$value": "{text.4xl}",
        "$type": "fontSizes",
        "$description": "4X Large font size."
      },
      "lg": {
        "$value": "{text.lg}",
        "$type": "fontSizes",
        "$description": "Large font size."
      },
      "base": {
        "$value": "{text.base}",
        "$type": "fontSizes",
        "$description": "Base/default font size."
      }
    },
    "text": {
      "emphasis": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.light}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Variation on the default text style used when text requires spoken emphasis."
      },
      "code": {
        "$value": {
          "fontFamilies": [
            "{font.mono}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.normal}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Text style used for displaying code as text."
      },
      "meta": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.xs}",
          "fontWeights": "{font-weight.normal}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Text style used for meta or legal text."
      },
      "link": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.normal}",
          "lineHeights": "{text.leading.normal}",
          "textDecoration": "underline"
        },
        "$type": "typography",
        "$description": "Text style used for links."
      },
      "strong": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.bold}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Variation on the default text style used when text requires to be spoken strongly."
      },
      "default": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.normal}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Default text style used for paragraphs, labels, and other basic text."
      },
      "quote": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.sm}",
          "fontWeights": "{font-weight.light}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Variation on the default text style used when quoting text."
      }
    },
    "heading": {
      "level-3": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.lg}",
          "fontWeights": "{font-weight.bold}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Heading style used for the next most important headings after heading level two."
      },
      "level-2": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.xl}",
          "fontWeights": "{font-weight.bold}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Heading style used for the next most important headings after heading level one."
      },
      "level-1": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.2xl}",
          "fontWeights": "{font-weight.bold}",
          "letterSpacing": "{tracking.tight}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Heading style used for the most important title or page title."
      }
    },
    "display": {
      "title": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.4xl}",
          "fontWeights": "{font-weight.bold}",
          "letterSpacing": "{tracking.normal}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Display title style used for dramatic text sizes on landing pages."
      },
      "subtitle": {
        "$value": {
          "fontFamilies": [
            "{font.sans}"
          ],
          "fontSizes": "{text.3xl}",
          "fontWeights": "{font-weight.bold}",
          "letterSpacing": "{tracking.normal}",
          "lineHeights": "{text.leading.normal}"
        },
        "$type": "typography",
        "$description": "Display subtitle style used for dramatic text sizes on landing pages."
      }
    },
    "family": {
      "code": {
        "$value": [
          "Atkinson Hyperlegible Mono"
        ],
        "$type": "fontFamilies",
        "$description": "Font family used for code blocks."
      },
      "default": {
        "$value": [
          "Inclusive Sans"
        ],
        "$type": "fontFamilies",
        "$description": "Font family used for body prose."
      }
    }
  }
}